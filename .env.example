# ResourceLens — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Nexus API
NEXUS_API_KEY=your_nexus_api_key_here
NEXUS_BASE_URL=https://api.nexus.navigatelabs.ai/v1

# Nexus model names (fill in from the Nexus catalogue after smoke-testing)
NEXUS_VISION_MODEL=nexus-vision-latest
NEXUS_STT_MODEL=nexus-stt-latest
NEXUS_LLM_A=nexus-llm-pro
NEXUS_LLM_B=nexus-llm-fast
NEXUS_TTS_MODEL=nexus-tts-latest

# Database
DATABASE_URL=sqlite:///./resourcelens.db

# App config
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
ANOMALY_THRESHOLD_PCT=20
ANOMALY_SIGMA=2.0
BASELINE_WEEKS=4

# Tariff config (stretch)
ENERGY_TARIFF_PER_KWH=7.5
WATER_TARIFF_PER_KL=45.0
TOD_PEAK_TARIFF=9.0
TOD_PEAK_HOURS=09:00-23:00

# CORS
FRONTEND_URL=http://localhost:5173

